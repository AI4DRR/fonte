# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_REASONING_EFFORT=medium
API_VERSION=YOUR_AZURE_OPENAI_API_VERSION

# Databricks SQL connection
DATABRICKS_SERVER_HOSTNAME=adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/1234567890abcdef
DATABRICKS_TOKEN=YOUR_DATABRICKS_PAT

# Source tables
DATABRICKS_SOURCE_ASSET_TABLE=undrr_d_datahub_databricks_ws.gold.asset_texts
DATABRICKS_SOURCE_CHUNK_TABLE=undrr_d_datahub_databricks_ws.gold.asset_text_chunks

# Optional: local/private certificate chain for Databricks TLS.
# DATABRICKS_CA_FILE=databricks_chain.pem

# Local folder for groundsource-extract output (JSONL/CSV) and the default
# source directory for groundsource-upload.
EXTRACT_OUTPUT_DIR=extract/demo

# Azure Blob Storage (groundsource-upload)
STORAGEACCOUNT_ENDPOINT=https://YOUR-ACCOUNT.blob.core.windows.net
STORAGEACCOUNT_TOKEN=YOUR_CONTAINER_SAS_TOKEN
STORAGEACCOUNT_OUTPUT_CONTAINER=groundsource-output
STORAGEACCOUNT_OUTPUT_PREFIX=demo

LOG_LEVEL=INFO
